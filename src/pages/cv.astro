---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume" sideBarActiveItemID="cv">
  <div class="mb-5 reveal">
    <div class="text-section">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-12 reveal reveal-delay-1">
    <TimeLineElement
      title="B.S. in Computer Science"
      subtitle="Currently enrolled at POSTECH, Pohang, South Korea"
    />
  </div>

  <div class="mb-5 reveal">
    <div class="text-section">Relevant Coursework</div>
  </div>

  <ul class="list-disc md:columns-2 columns-1 mx-6 mb-12 space-y-1 opacity-80 reveal reveal-delay-1">
    <li>Data Structures</li>
    <li>Algorithms</li>
    <li>Operating Systems</li>
    <li>Computer Architecture</li>
    <li>Object-Oriented Programming</li>
    <li>Artificial Intelligence</li>
    <li>Human-Computer Interaction</li>
    <li>Probability and Statistics</li>
    <li>Network <i>(Enrolled)</i></li>
    <li>Social Computing <i>(Enrolled)</i></li>
    <li>AI-Security <i>(Enrolled)</i></li>
  </ul>

  <div class="mb-5 reveal">
    <div class="text-section">Experience</div>
  </div>

  <div class="time-line-container mb-12 reveal reveal-delay-1">
    <TimeLineElement
      title="Software Development Intern"
      subtitle="From Jun 2025 to Aug 2025 at BlueSlab Co., Ltd., Seoul, South Korea"
    >
      Upcoming software development internship.
    </TimeLineElement>
    
    <TimeLineElement
      title="Undergraduate Research Intern"
      subtitle="From Dec 2024 to Apr 2025 at HIS-LAB (Prof. Inseok Hwang), POSTECH, Pohang, South Korea"
    >
      Participated in Human-Computer Interaction (HCI) research and gained practical experience in conducting user interviews and qualitative research methods.
    </TimeLineElement>

    <TimeLineElement
      title="Undergraduate Research Intern"
      subtitle="From Jun 2024 to Aug 2024 at Computer Vision Lab (Prof. Minsu Cho), POSTECH, Pohang, South Korea"
    >
      Completed an educational internship with a focus on deep learning. Participated in a study group covering the Stanford CS231n (Deep Learning for Computer Vision) curriculum and conducted a final transfer learning project.
    </TimeLineElement>
  </div>

  <div class="mb-5 reveal">
    <div class="text-section">Publications</div>
  </div>

  <div class="mb-12 reveal reveal-delay-1">
    <div class="text-base opacity-50">There are no publications to display at this time.</div>
  </div>
</BaseLayout>
