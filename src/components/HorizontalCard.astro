---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
const tag_url = url.split("/").slice(0, -1).join("/") + "/tag";
---

<div class="card-apple bg-base-100">
  <a href={url} target={target}>
    <div class="hero-content flex-col md:flex-row p-5">
      {
        img && (
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-xl"
          />
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-semibold tracking-tight">
          {title}
          {badge && <div class="badge badge-secondary mx-2 text-xs">{badge}</div>}
        </h1>
        <p class="py-1 text-base opacity-70">{desc}</p>
        <div class="card-actions justify-end mt-2">
          {
            tags &&
              tags.map((tag) => (
                <a href={`${tag_url}/${tag}`} class="badge badge-outline text-xs opacity-60">
                  {tag}
                </a>
              ))
          }
        </div>
      </div>
    </div>
  </a>
</div>
