---
const { sideBarActiveItemID } = Astro.props;
---

<ul class="menu grow shrink menu-md overflow-y-auto gap-1 px-2">
    <li><a class="menu-item-apple text-base" id="home" href="/">Home</a></li>
    <li><a class="menu-item-apple text-base" id="about" href="/about">About</a></li>
    <li><a class="menu-item-apple text-base" id="projects" href="/projects">Projects</a></li>
    <li><a class="menu-item-apple text-base" id="blog" href="/blog/">Blog</a></li>
    <li><a class="menu-item-apple text-base" id="cv" href="/cv">CV</a></li>
</ul>

<script define:vars={{ sideBarActiveItemID: sideBarActiveItemID }}>
const activeItemElem = document.getElementById(sideBarActiveItemID);
activeItemElem && activeItemElem.classList.add('active');
</script>
