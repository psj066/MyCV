---
const { title, subtitle } = Astro.props;
---

<div class="flex">
  <div class="education__time">
    <span class="w-3 h-3 bg-neutral-400 block rounded-full mt-1.5"></span>
    <span class="education__line bg-neutral-300 block h-full w-[1.5px] translate-x-[5px]"></span>
  </div>
  <div class="experience__data bd-grid px-5 pb-2">
    <h3 class="font-semibold tracking-tight mb-1">{title}</h3>
    <span class="font-light text-sm opacity-60">{subtitle}</span>
    <p class="my-2 text-justify opacity-80">
      <slot />
    </p>
  </div>
</div>
