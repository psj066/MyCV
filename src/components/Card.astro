---
const { title, img, desc, url, badge, tags, target = "_blank" } = Astro.props;
import { Image } from "astro:assets";
---

<div class="md:w-1/3 w-full">
  <a href={url} target={target}>
    <div class="card-apple bg-base-100 mx-6 my-2">
      <Image width={750} height={422} format="webp" src={img} alt={title} class="rounded-t-2xl" />
      <div class="card-body">
        <h2 class="card-title font-semibold tracking-tight">
          {title}
          {badge && <div class="badge badge-secondary text-xs">{badge}</div>}
        </h2>
        <p class="opacity-70">{desc}</p>
        <div class="card-actions justify-end">
          {tags && tags.map((tag) => <div class="badge badge-outline text-xs opacity-60">{tag}</div>)}
        </div>
      </div>
    </div>
  </a>
</div>
